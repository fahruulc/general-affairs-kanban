generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN
  OFFICER
  EMPLOYEE
}

enum ReportCategory {
  BUILDING
  CATERING
  FACILITY
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
}

enum ReportStatus {
  NEW
  IN_PROGRESS
  DONE
  REJECTED
}

enum AttachmentKind {
  BEFORE
  AFTER
}

model Department {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  @@map("departments")
}

model User {
  id                 String   @id @default(cuid())
  employeeNo         String?  @unique
  name               String
  email              String   @unique
  passwordHash       String
  role               Role     @default(EMPLOYEE)
  isActive           Boolean  @default(true)
  mustChangePassword Boolean  @default(true)
  phone              String?
  departmentId       String?
  department         Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  reportsCreated  Report[]          @relation("ReportReporter")
  reportsAssigned Report[]          @relation("ReportAssignee")
  attachments     Attachment[]
  statusLogs      ReportStatusLog[]
  comments        Comment[]

  @@index([role, isActive])
  @@map("users")
}

model Report {
  id              String         @id @default(cuid())
  number          Int            @unique @default(autoincrement())
  title           String
  description     String
  category        ReportCategory
  priority        ReportPriority @default(MEDIUM)
  status          ReportStatus   @default(NEW)
  locationDetail  String
  resolutionNote  String?
  rejectionReason String?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  reporterId String
  reporter   User    @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assigneeId String?
  assignee   User?   @relation("ReportAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  attachments Attachment[]
  statusLogs  ReportStatusLog[]
  comments    Comment[]

  @@index([status, category])
  @@index([reporterId, createdAt])
  @@index([assigneeId, status])
  @@map("reports")
}

model Attachment {
  id           String         @id @default(cuid())
  kind         AttachmentKind
  objectKey    String         @unique
  fileName     String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime       @default(now())

  reportId     String
  report       Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([reportId, kind])
  @@map("attachments")
}

model ReportStatusLog {
  id         String        @id @default(cuid())
  fromStatus ReportStatus?
  toStatus   ReportStatus
  note       String?
  createdAt  DateTime      @default(now())

  reportId   String
  report     Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorId    String
  actor      User   @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("report_status_logs")
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  reportId  String
  report    Report @relation(fields: [reportId], references: [id], onDelete: Cascade)
  authorId  String
  author    User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@index([reportId, createdAt])
  @@map("comments")
}
